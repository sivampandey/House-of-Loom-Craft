# ==========================================================
# House of Loom & Craft — Backend Environment Variables
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://pottery-rugs.vercel.app
BACKEND_URL=https://pottery-rugs-api.onrender.com
# Optional comma-separated list of additional trusted origins (e.g. staging domains)
ALLOWED_ORIGINS=

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.example.mongodb.net/house_of_loom?retryWrites=true&w=majority

# JWT Authentication (Cryptographically secure 64+ char random secret)
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Live production keys from Razorpay Dashboard -> Account & Settings -> API Keys)
# Key ID starts with rzp_live_ (or rzp_test_ for staging/test mode)
RAZORPAY_KEY_ID=
# Key Secret (Confidential; NEVER expose to frontend or git)
RAZORPAY_KEY_SECRET=
# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks for https://<BACKEND_URL>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
# Simulation MUST strictly be false in production!
RAZORPAY_SIMULATION=false

# Transactional Email Service (Password recovery & ticket notifications)
# Supported providers: resend | sendgrid
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Sender Identity
EMAIL_FROM=House of Loom & Craft <Potteryrugs@gmail.com>

# Demo Seeding (MUST remain false in production to prevent test data injection)
SEED_DEMO_USERS=false

# Google Gemini AI Assistant (Concierge Chatbot)
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Atelier Support & Escalations
SHOP_WHATSAPP_NUMBER=917460007382
SHOP_WHATSAPP_NUMBER_SECONDARY=919839116625
SHOP_SUPPORT_EMAIL=Potteryrugs@gmail.com

