# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://pottery-rugs.vercel.app
BACKEND_URL=https://pottery-rugs-api.onrender.com
# Optional comma-separated list of additional trusted origins (e.g. staging domains)
ALLOWED_ORIGINS=

# MongoDB Database Connection (Atlas or local)
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.slnhlei.mongodb.net/pottery_rugs?appName=Cluster0

# JWT Authentication
# In production, set a cryptographically secure 64+ char random secret
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
# In production, acquire live keys from Razorpay Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Development toggle for local offline payment simulation. MUST be false in production!
RAZORPAY_SIMULATION=false

# Production Email Service (Password Recovery)
# Supported providers: resend | sendgrid
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM='House of Loom & Craft <Potteryrugs@gmail.com>

# Seed Initial Demo Accounts (Optional - Disabled by default to protect production users)
SEED_DEMO_USERS=false

# Google Gemini AI Assistant (Pottery Rugs Concierge)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# WhatsApp Business Cloud API & Complaint Escalations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SHOP_WHATSAPP_NUMBER=917460007382
SHOP_WHATSAPP_NUMBER_SECONDARY=919839116625
SHOP_SUPPORT_EMAIL=Potteryrugs@gmail.com

